# Local models only: no OpenAI API key or paid API calls are needed.
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_assistant
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=900
CHUNK_OVERLAP=150
SEMANTIC_TOP_K=8
BM25_TOP_K=8
FINAL_TOP_K=5
MAX_COSINE_DISTANCE=0.70
ENABLE_LLM_RERANKER=false
MAX_UPLOAD_BYTES=20971520
