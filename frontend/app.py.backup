import os

import requests
import streamlit as st

API_URL = os.getenv("RAG_API_URL", "http://localhost:8000").rstrip("/")

st.set_page_config(page_title="RAG Knowledge Assistant", page_icon="📚", layout="wide")
st.title("📚 RAG Knowledge Assistant")
st.caption("Ask questions about your documents and inspect the cited sources.")

with st.sidebar:
    st.subheader("1. Add a document")
    uploaded_file = st.file_uploader("Choose a text-based PDF", type=["pdf"])
    if st.button("Upload and index PDF", type="primary", disabled=uploaded_file is None, use_container_width=True):
        try:
            with st.spinner("Extracting text and creating embeddings..."):
                response = requests.post(
                    f"{API_URL}/documents/upload",
                    files={"file": (uploaded_file.name, uploaded_file.getvalue(), "application/pdf")},
                    timeout=180,
                )
            if response.ok:
                st.success(response.json().get("message", "Upload complete"))
                st.json(response.json())
            else:
                st.error(response.text)
        except requests.RequestException as exc:
            st.error(f"Could not reach the API at {API_URL}. Start the backend first. Details: {exc}")

    st.divider()
    st.subheader("2. Indexed documents")
    try:
        documents_response = requests.get(f"{API_URL}/documents", timeout=10)
        if documents_response.ok:
            documents = documents_response.json().get("documents", [])
            if documents:
                for doc in documents:
                    st.write(f"**{doc['filename']}** — {doc['chunks']} chunks")
            else:
                st.caption("No documents uploaded yet.")
        else:
            st.caption("Document list is unavailable.")
    except requests.RequestException:
        st.caption("Start the backend to view indexed documents.")

st.subheader("Ask a question")
question = st.text_area("Question", placeholder="What does the document say about...?", height=90)
if st.button("Get answer", type="primary"):
    if len(question.strip()) < 3:
        st.warning("Enter a question of at least three characters.")
    else:
        try:
            with st.spinner("Searching documents and generating a cited answer..."):
                response = requests.post(f"{API_URL}/ask", json={"question": question}, timeout=180)
            if response.ok:
                result = response.json()
                st.markdown("### Answer")
                st.markdown(result["answer"])
                st.caption(f"Response time: {result['latency_ms']} ms · Retrieved citations: {result['retrieval_count']}")
                st.markdown("### Sources")
                if result["citations"]:
                    for citation in result["citations"]:
                        with st.expander(f"[{citation['citation_id']}] {citation['source']} — page {citation['page']}"):
                            st.write(citation["snippet"])
                            st.caption(f"RRF retrieval score: {citation['retrieval_score']}")
                else:
                    st.caption("No supporting passages were retrieved for this answer.")
            else:
                st.error(response.text)
        except requests.RequestException as exc:
            st.error(f"Could not reach the API at {API_URL}. Start the backend first. Details: {exc}")
